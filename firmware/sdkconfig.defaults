# sdkconfig.defaults
# ===================
# This file sets default configuration values for ESP-IDF's menuconfig system.
# When you run `idf.py build` for the first time, these values are used
# to generate the `sdkconfig` file (which is the actual config used at compile time).
#
# WHY THIS FILE EXISTS:
#   ESP-IDF has hundreds of configurable options (Wi-Fi, FreeRTOS, flash size, etc.)
#   Instead of manually running `idf.py menuconfig` every time,
#   we put our project-specific defaults here so the build just works.
#
# HOW TO USE:
#   1. Edit the values below (especially WIFI_SSID, WIFI_PASSWORD, AGENT_IP)
#   2. Run: idf.py build
#   If sdkconfig already exists, delete it first: rm sdkconfig
#
# !! IMPORTANT: Change these 3 values to match YOUR network !!

# ── Wi-Fi Configuration ───────────────────────────────────────────────────────
# Your home/lab Wi-Fi network name (SSID)
CONFIG_ESP_WIFI_SSID="Pixel_8A"

# Your Wi-Fi password
CONFIG_ESP_WIFI_PASSWORD="12345678"

# The IP address of your Ubuntu PC on the same Wi-Fi network
# Find it by running: ip addr show | grep "inet " on your PC
CONFIG_MICRO_ROS_AGENT_IP="10.196.235.13"

# The UDP port the micro-ROS agent listens on (must match robot.launch.py)
CONFIG_MICRO_ROS_AGENT_PORT="8888"

# ── FreeRTOS Configuration ────────────────────────────────────────────────────
# FreeRTOS tick rate in Hz (how often the scheduler runs)
# 1000 Hz = 1ms tick resolution — needed for accurate 200Hz control loops
# Default is 100 Hz which is too coarse for our balance controller
CONFIG_FREERTOS_HZ=1000

# ── Memory Configuration ──────────────────────────────────────────────────────
# Main task stack size in bytes — micro-ROS needs a large stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ── Wi-Fi Power/Performance ───────────────────────────────────────────────────
# Disable Wi-Fi power saving — we need low latency for micro-ROS
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# Maximum Wi-Fi TX power for best range
CONFIG_ESP_WIFI_DYNAMIC_TX_POWER=y

# ── micro-ROS Specific ────────────────────────────────────────────────────────
# Transport: UDP (matches micro_ros_agent udp4 command)
CONFIG_MICRO_ROS_TRANSPORT_UDP=y

# Number of micro-ROS publishers we create:
# /imu/data, /line_sensors, /balance_telemetry, /joint_states = 4
CONFIG_MICRO_ROS_APP_TASK_STACK_SIZE=16000

# ── Hardware Configuration ────────────────────────────────────────────────────
# I2C master clock frequency for MPU6050 (400kHz = fast mode)
CONFIG_I2C_MASTER_FREQUENCY=400000

# Number of ADC samples to average per reading (reduces LSA noise)
CONFIG_NUMBER_OF_SAMPLES=5

# ── Flash Size ────────────────────────────────────────────────────────────────
# SRA Board has 4MB flash — set correctly for partition table
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
