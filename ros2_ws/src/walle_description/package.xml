<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>walle_description</name>
  <version>0.1.0</version>
  <description>URDF robot model and RViz2 configuration for Wall-E robot</description>
  <maintainer email="you@email.com">Your Name</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- xacro is needed to process the .urdf.xacro file at launch time -->
  <exec_depend>xacro</exec_depend>
  <!-- robot_state_publisher reads URDF and broadcasts TF transforms -->
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- joint_state_publisher publishes default joint states (for testing without ESP32) -->
  <exec_depend>joint_state_publisher</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
