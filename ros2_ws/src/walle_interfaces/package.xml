<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <!--
  ── What is package.xml? ──────────────────────────────────────────
  This is the "identity card" of a ROS2 package.
  It tells the ROS2 ecosystem:
    - What this package is called
    - Who maintains it
    - What other packages it needs to work
    - What type of build system it uses

  When you run `rosdep install` or `colcon build`, ROS2 reads
  package.xml files to figure out the dependency tree.
  ──────────────────────────────────────────────────────────────────
  -->

  <!-- The unique name of this package. Must match project() in CMakeLists.txt -->
  <name>walle_interfaces</name>

  <!-- Version number: major.minor.patch -->
  <version>0.1.0</version>

  <!-- A human-readable description shown in ros2 pkg list -->
  <description>
    Custom ROS2 message and service interfaces for the Wall-E
    self-balancing and line-following robot. Defines:
    LineSensorArray.msg, BalanceTelemetry.msg,
    SetPidGains.srv, SetMode.srv.
  </description>

  <!-- Who to contact if something breaks -->
  <maintainer email="you@email.com">Your Name</maintainer>

  <!-- Open source license. MIT = very permissive, anyone can use -->
  <license>MIT</license>

  <!--
  buildtool_depend: needed to BUILD this package (not at runtime).
  ament_cmake is the ROS2 CMake build tool.
  -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!--
  build_depend: needed at BUILD TIME (when compiling).
  rosidl_default_generators is the tool that reads .msg/.srv files
  and generates C/C++/Python code from them.
  -->
  <build_depend>rosidl_default_generators</build_depend>

  <!--
  exec_depend: needed at RUNTIME (when running nodes).
  rosidl_default_runtime provides the runtime support for generated code.
  std_msgs provides the Header type we use in our messages.
  -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!--
  member_of_group: registers this package as an interface package.
  This is how other packages know they can import types from us.
  -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
