<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>walle_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for bringing up the Wall-E robot system</description>
  <maintainer email="you@email.com">Your Name</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- All packages that this bringup starts -->
  <exec_depend>walle_control</exec_depend>
  <exec_depend>walle_description</exec_depend>
  <exec_depend>walle_interfaces</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
